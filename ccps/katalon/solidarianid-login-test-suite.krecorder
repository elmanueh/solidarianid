<tr><td>click</td><td>xpath=//button[@type='submit']<datalist><option>xpath=//button[@type='submit']</option><option>xpath=//form[@id='login-form']/div[3]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Utiliza un formato que coincida con el solicitado'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Otros apartados'])[1]/preceding::button[1]</option><option>xpath=//div[3]/button</option><option>css=button.btn.btn-primary.btn-lg</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=email<datalist><option>id=email</option><option>name=email</option><option>xpath=//input[@id='email']</option><option>xpath=//form[@id='login-form']/div/div/input</option><option>xpath=//input</option><option>css=#email</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=email<datalist><option>id=email</option><option>name=email</option><option>xpath=//input[@id='email']</option><option>xpath=//form[@id='login-form']/div/div/input</option><option>xpath=//input</option><option>css=#email</option></datalist></td><td>sergio.garcia@solidarianid.org</td></tr>
<tr><td>click</td><td>id=password<datalist><option>id=password</option><option>name=password</option><option>xpath=//input[@id='password']</option><option>xpath=//form[@id='login-form']/div[2]/div/input</option><option>xpath=//div[2]/div/input</option><option>css=#password</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@type='button']<datalist><option>xpath=//button[@type='button']</option><option>xpath=//form[@id='login-form']/div[2]/div/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[2]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Utiliza un formato que coincida con el solicitado'])[1]/preceding::button[1]</option><option>xpath=//button</option><option>css=button.password-toggle</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@type='button']<datalist><option>xpath=//button[@type='button']</option><option>xpath=//form[@id='login-form']/div[2]/div/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[2]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Utiliza un formato que coincida con el solicitado'])[1]/preceding::button[1]</option><option>xpath=//button</option><option>css=button.password-toggle</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@type='submit']<datalist><option>xpath=//button[@type='submit']</option><option>xpath=//form[@id='login-form']/div[3]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Utiliza un formato que coincida con el solicitado'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Otros apartados'])[1]/preceding::button[1]</option><option>xpath=//div[3]/button</option><option>css=button.btn.btn-primary.btn-lg</option></datalist></td><td></td></tr>
