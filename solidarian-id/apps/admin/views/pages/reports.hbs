<main class='min-h-screen bg-gradient-to-br from-black-haze-50 to-athens-gray-100 dark:from-black-haze-950 dark:to-athens-gray-950 px-4 py-8'>
  <div class='container mx-auto max-w-7xl'>
    <!-- Header -->
    <header class='text-center mb-8'>
    <h1 class='text-3xl md:text-4xl font-bold text-black-haze-950 dark:text-black-haze-50 mb-2'>
        Reportes de Usuarios
      </h1>
      <p class='text-pale-sky-500 dark:text-pale-sky-400'>
        Total de usuarios:
        <span id='total-users' class='font-semibold text-ocean-blue-600 dark:text-ocean-blue-400'>-</span>
      </p>
    </header>

    <!-- Announcer para lectores de pantalla -->
    <div
      id='status-announcer'
      class='sr-only'
      aria-live='polite'
      aria-atomic='true'
    ></div>

    <!-- Lista de usuarios -->
    <section class='min-h-[400px] mb-8' aria-label='Lista de usuarios'>
      <div
        id='users-list'
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'
      >
        <!-- Tarjetas de usuario se generan dinámicamente con JS -->
      </div>

      <!-- Loading spinner -->
      <div
        id='loading'
        class='flex flex-col items-center justify-center min-h-[400px] hidden'
      >
        <span
          class='loading loading-spinner loading-lg text-ocean-blue-600'
        ></span>
        <p class='mt-4 text-pale-sky-500 dark:text-pale-sky-400'>
          Cargando usuarios...
        </p>
      </div>

      <!-- Empty state -->
      <div
        id='empty-state'
        class='flex flex-col items-center justify-center min-h-[400px] hidden'
      >
        <span
          class='icon-[lucide--user-x] text-6xl text-pale-sky-400 dark:text-pale-sky-600 mb-4'
        ></span>
        <p class='text-pale-sky-500 dark:text-pale-sky-400'>
          No se encontraron usuarios
        </p>
      </div>

      <!-- Error state -->
      <div
        id='error-state'
        class='flex flex-col items-center justify-center min-h-[400px] hidden'
      >
        <span
          class='icon-[lucide--alert-circle] text-6xl text-dark-wine-500 dark:text-dark-wine-400 mb-4'
        ></span>
        <p class='text-pale-sky-600 dark:text-pale-sky-400 mb-4'>
          Error al cargar los usuarios
        </p>
        <button type='button' id='retry-btn' class='btn btn-primary'>
          <span class='icon-[lucide--refresh-cw]'></span>
          Reintentar
        </button>
      </div>
    </section>

    <!-- Paginación -->
    <nav
      id='pagination'
      class='flex justify-center gap-2 mb-8'
      aria-label='Paginación de usuarios'
    >
      <!-- Botones de paginación se generan dinámicamente con JS -->
    </nav>
  </div>

  <!-- Panel de detalle (drawer lateral) -->
  <div id='user-detail-panel' class='hidden'>
    <!-- Overlay -->
    <div
      id='panel-overlay'
      class='fixed inset-0 bg-black/20 dark:bg-white/10 backdrop-blur-sm z-40 transition-all duration-300 opacity-0'
    ></div>

    <!-- Panel -->
    <aside
      class='fixed top-0 right-0 bottom-0 w-full max-w-md bg-white dark:bg-black-haze-900 shadow-2xl z-50 flex flex-col transform transition-transform duration-300 ease-in-out translate-x-full'
      id='panel-content'
      role='complementary'
      aria-labelledby='detail-title'
    >
      <!-- Header del panel -->
      <div
        class='flex items-center justify-between p-6 border-b border-iron-200 dark:border-iron-700'
      >
        <h2
          id='detail-title'
          class='text-2xl font-bold text-black-haze-950 dark:text-black-haze-50'
        >
          Información del Usuario
        </h2>
        <button
          type='button'
          id='close-detail'
          class='btn btn-ghost btn-sm btn-circle'
          aria-label='Cerrar panel'
        >
          <span class='icon-[lucide--x] text-xl'></span>
        </button>
      </div>

      <!-- Contenido del panel -->
      <div
        id='detail-content'
        class='flex-1 overflow-y-auto p-6 space-y-6'
      >
        <!-- Se llena dinámicamente con JS -->
      </div>

      <!-- Acciones del panel -->
      <div class='p-6 border-t border-iron-200 dark:border-iron-700'>
        <button
          type='button'
          id='download-pdf'
          class='btn btn-primary w-full'
          disabled
        >
          <span class='icon-[lucide--download]'></span>
          Descargar PDF
        </button>
      </div>
    </aside>
  </div>
</main>

<script defer src='/js/reports.js'></script>
