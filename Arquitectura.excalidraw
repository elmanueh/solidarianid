    {
      "id": "990ML5oOa9BAeaW2YvuEU",
      "type": "text",
      "x": 227.54248377699344,
      "y": -1642.447814242389,
      "width": 566.8927306139511,
      "height": 385.6872204180587,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
