<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>solidarianid-login-test-suite</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">login-test-case-succesful</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>http://localhost:3000/login<datalist><option>http://localhost:3000/login</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=email<datalist><option>id=email</option><option>name=email</option><option>xpath=//input[@id='email']</option><option>xpath=//form[@id='login-form']/div/div/input</option><option>xpath=//input</option><option>css=#email</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=email<datalist><option>id=email</option><option>name=email</option><option>xpath=//input[@id='email']</option><option>xpath=//form[@id='login-form']/div/div/input</option><option>xpath=//input</option><option>css=#email</option></datalist></td><td>sergio.garcia@solidarianid.org</td></tr>
<tr><td>click</td><td>id=password<datalist><option>id=password</option><option>name=password</option><option>xpath=//input[@id='password']</option><option>xpath=//form[@id='login-form']/div[2]/div/input</option><option>xpath=//div[2]/div/input</option><option>css=#password</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=password<datalist><option>id=password</option><option>name=password</option><option>xpath=//input[@id='password']</option><option>xpath=//form[@id='login-form']/div[2]/div/input</option><option>xpath=//div[2]/div/input</option><option>css=#password</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=password<datalist><option>id=password</option><option>name=password</option><option>xpath=//input[@id='password']</option><option>xpath=//form[@id='login-form']/div[2]/div/input</option><option>xpath=//div[2]/div/input</option><option>css=#password</option></datalist></td><td>Admin2024!Pass</td></tr>
<tr><td>click</td><td>id=login-form<datalist><option>id=login-form</option><option>xpath=//form[@id='login-form']</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Iniciar Sesión'])[1]/following::form[1]</option><option>xpath=//form</option><option>css=#login-form</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//form[@id='login-form']/div[3]/button/span[2]<datalist><option>xpath=//form[@id='login-form']/div[3]/button/span[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='*'])[2]/following::span[7]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Otros apartados'])[1]/preceding::span[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Métricas'])[1]/preceding::span[1]</option><option>xpath=//*/text()[normalize-space(.)='Iniciar sesión']/parent::*</option><option>xpath=//button/span[2]</option></datalist></td><td></td></tr>
<tr><td>open</td><td>http://localhost:3000/dashboard<datalist><option>http://localhost:3000/dashboard</option></datalist></td><td></td></tr>
</tbody></table>
