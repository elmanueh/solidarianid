<main class='metrics' role='main' aria-labelledby='page-title'>
  <script src='https://cdn.jsdelivr.net/npm/chart.js'></script>
  <script id='charts-data' type='application/json'>
    {{{charts}}}
  </script>
  <script src='/js/lib/charts.js'></script>
  <script src='/js/metrics.js'></script>

  <h1 id='page-title' class='metrics-title'>Dashboard</h1>

  <section
    class='metrics-container'
    aria-label='Métricas y gráficos del sistema'
  >

    <div
      class='metrics-analytics'
      role='region'
      aria-label='Gráficos analíticos'
    >
      <div class='metrics-analytics-graph'>
        <canvas
          id='chart-communities'
          role='img'
          aria-label='Gráfico de comunidades con más usuarios'
        ></canvas>
      </div>
      <div class='metrics-analytics-graph'>
        <canvas
          id='chart-nationalities'
          role='img'
          aria-label='Gráfico de nacionalidades más comunes'
        ></canvas>
      </div>
      <div class='metrics-analytics-graph'>
        <canvas
          id='chart-ods'
          role='img'
          aria-label='Gráfico de causas por Objetivos de Desarrollo Sostenible'
        ></canvas>
      </div>
      <div class='metrics-analytics-graph'>
        <canvas
          id='chart-joins'
          role='img'
          aria-label='Gráfico comparativo de uniones mensuales'
        ></canvas>
      </div>
    </div>

    <div
      class='metrics-summary'
      role='region'
      aria-label='Resumen de estadísticas'
    >
      <article class='metrics-summary-card' data-variant='green' tabindex='0'>
        <h3 class='metrics-summary-card-title'>Nº Comunidades</h3>
        <p
          class='metrics-summary-card-value'
          aria-label='Total de comunidades: {{dataSummary.totalComunities}}'
        >{{dataSummary.totalComunities}}</p>
      </article>

      <article class='metrics-summary-card' data-variant='orange' tabindex='0'>
        <h3 class='metrics-summary-card-title'>Usuarios Activos</h3>
        <p
          class='metrics-summary-card-value'
          aria-label='Total de usuarios activos: {{dataSummary.totalUsers}}'
        >{{dataSummary.totalUsers}}</p>
      </article>

      <article class='metrics-summary-card' data-variant='sofa' tabindex='0'>
        <h3 class='metrics-summary-card-title'>Nº Causas</h3>
        <p
          class='metrics-summary-card-value'
          aria-label='Total de causas: {{dataSummary.totalCauses}}'
        >{{dataSummary.totalCauses}}</p>
      </article>

      <article class='metrics-summary-card' data-variant='red' tabindex='0'>
        <h3 class='metrics-summary-card-title'>Nº Acciones</h3>
        <p
          class='metrics-summary-card-value'
          aria-label='Total de acciones: {{dataSummary.totalActions}}'
        >{{dataSummary.totalActions}}</p>
      </article>
    </div>

  </section>
</main>