{
  "name": "solidarian-id",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build admin communities users",
    "proto:wingen:communities": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./libs/grpc-common/src --ts_proto_opt=nestJs=true,outputServices=grpc-js,esModuleInterop=true,useOptionals=messages,oneof=unions --proto_path=./libs/grpc-common/spec --proto_path=./node_modules ./libs/grpc-common/spec/solidarianid/grpc/communities/communities.proto",
    "proto:gen:communities": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./libs/grpc-common/src --ts_proto_opt=nestJs=true,outputServices=grpc-js,esModuleInterop=true,useOptionals=messages,oneof=unions --proto_path=./libs/grpc-common/spec --proto_path=./node_modules ./libs/grpc-common/spec/solidarianid/grpc/communities/communities.proto",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/admin/main",
    "build:sass": "sass libs/design-tokens/src/requests.scss libs/design-tokens/src/requests.css --no-source-map",
    "sass:watch": "sass libs/design-tokens/src:libs/design-tokens/src --watch --no-source-map",
    "build:tailwind": "npx @tailwindcss/cli -i ./libs/design-tokens/src/app.css -o ./apps/admin/public/css/main.css",
    "tailwind:dev": "npx @tailwindcss/cli -i ./libs/design-tokens/src/app.css -o ./apps/admin/public/css/main.css --watch",
    "docker:up": "docker-compose up -d",
    "build:charts": "esbuild libs/charts/src/plugins/plugins.ts --bundle --outfile=apps/admin/public/js/lib/charts.js --format=iife --global-name=ChartsLib",
    "prettier:write": "prettier --write \"{apps,libs}/**/*.{ts,js,json,html,css,md}\"",
    "prettier:check": "prettier --check \"{apps,libs}/**/*.{ts,js,json,html,css,md}\"",
    "lint": "eslint \"{apps,libs}/**/*.{ts,js}\"",
    "lint:ci": "eslint \"{apps,libs}/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "test:admin": "npm run test -- --testPathPatterns=apps/admin",
    "test:users": "npm run test -- --testPathPatterns=apps/users",
    "test:communities": "npm run test -- --testPathPatterns=apps/communities",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/e2e/jest-e2e.config.ts",
    "test:e2e:admin": "cross-env NODE_ENV=test jest --config ./apps/admin/jest-e2e.config.ts",
    "test:e2e:users": "cross-env NODE_ENV=test jest --config ./apps/users/jest-e2e.config.ts",
    "test:e2e:communities": "cross-env NODE_ENV=test jest --config ./apps/communities/jest-e2e.config.ts",
    "test:integration": "cross-env NODE_ENV=test jest --config ./test/integration/jest-e2e.config.ts",
    "test:e2e:coverage": "cross-env NODE_ENV=test jest --config ./apps/communities/jest-e2e.config.ts --coverage && jest --config ./apps/users/jest-e2e.config.ts --coverage && jest --config ./apps/admin/jest-e2e.config.ts --coverage",
    "test:all:coverage": "npm run test && npm run test:e2e && node -e \"const fs=require('fs');const p=require('path');['coverage','coverage-e2e/all'].forEach(d=>{try{const f=p.join(d,'coverage-final.json');if(fs.existsSync(f)){const t='.nyc_output';if(!fs.existsSync(t))fs.mkdirSync(t);fs.copyFileSync(f,p.join(t,d.replace(/[\\/]/g,'-')+'.json'))}}catch(e){}})\" && nyc report --reporter=text --reporter=html --reporter=lcov",
    "test:mutation": "npx stryker run",
    "test:mutation:users": "stryker run",
    "cypress:open": "cypress open --config-file ./apps/admin/test/cypress/cypress.config.js",
    "cypress:run": "cypress run --config-file ./apps/admin/test/cypress/cypress.config.js",
    "start:test:admin": "cross-env NODE_ENV=test nest start admin",
    "start:test:users": "cross-env NODE_ENV=test nest start users",
    "start:test:communities": "cross-env NODE_ENV=test nest start communities",
    "docker": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev": "docker compose --env-file .env.development up -d --build",
    "docker:dev:down": "docker compose --env-file .env.development down",
    "docker:test": "docker compose -f docker-compose.test.yml --env-file .env.test up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "db:seed": "cross-env NODE_ENV=production npx ts-node -r tsconfig-paths/register scripts/seed/index.ts",
    "db:export": "ts-node scripts/database/index.ts",
    "mig:gen:users": "cross-env NODE_ENV=production POSTGRES_HOST=localhost npx typeorm-ts-node-commonjs migration:generate apps/users/src/infrastructure/persistence/migrations/Auto -d apps/users/src/infrastructure/persistence/data-source.ts",
    "mig:gen:communities": "cross-env NODE_ENV=production POSTGRES_HOST=localhost npx typeorm-ts-node-commonjs migration:generate apps/communities/src/infrastructure/persistence/migrations/Auto -d apps/communities/src/infrastructure/persistence/data-source.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@iconify/tailwind": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cross-env": "^10.1.0",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-jest": "^29.11.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "express-handlebars": "^8.0.2",
    "express-session": "^1.18.2",
    "hbs": "^4.2.0",
    "js-yaml": "^4.1.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shallow-equal-object": "^1.1.1",
    "tailwindcss": "^4.1.18",
    "typeorm": "^0.3.28",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^9.3.0",
    "@iconify/json": "^2.2.419",
    "@iconify/tailwind4": "^1.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/jest-runner": "^9.4.0",
    "@testcontainers/kafka": "^11.11.0",
    "@testcontainers/mongodb": "^11.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/hbs": "^4.0.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.3",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "cypress": "^15.8.1",
    "daisyui": "^5.5.14",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2",
    "sass": "^1.97.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.10.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
