{
  "name": "solidarian-id",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/admin/main",
    "build:tailwind": "npx @tailwindcss/cli -i .\\libs\\design-tokens\\src\\app.css -o .\\apps\\admin\\public\\css\\main.css",
    "tailwind:dev": "npx @tailwindcss/cli -i .\\libs\\design-tokens\\src\\app.css -o .\\apps\\admin\\public\\css\\main.css --watch",
    "docker:up": "docker-compose up -d",
    "build:charts": "esbuild libs/charts/src/plugins/plugins.ts --bundle --outfile=apps/admin/public/js/lib/charts.js --format=iife --global-name=ChartsLib",
    "lint": "eslint \"{apps,libs}/**/*.{ts,js}\"",
    "lint:ci": "eslint \"{apps,libs}/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "cross-env NODE_ENV=test jest",
    "test:admin": "npm run test -- --testPathPattern=apps/admin",
    "test:users": "npm run test -- --testPathPattern=apps/users",
    "test:communities": "npm run test -- --testPathPattern=apps/communities",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run test:e2e:admin && npm run test:e2e:users && npm run test:e2e:communities",
    "test:e2e:admin": "cross-env NODE_ENV=test jest --config ./apps/admin/jest-e2e.config.ts",
    "test:e2e:users": "cross-env NODE_ENV=test jest --config ./apps/users/jest-e2e.config.ts",
    "test:e2e:communities": "cross-env NODE_ENV=test jest --config ./apps/communities/jest-e2e.config.ts",
    "test:e2e:coverage": "cross-env NODE_ENV=test jest --config ./apps/communities/jest-e2e.config.ts --coverage && jest --config ./apps/users/jest-e2e.config.ts --coverage && jest --config ./apps/admin/jest-e2e.config.ts --coverage",
    "test:mutation": "npx stryker run",
    "cypress:open": "cypress open --config-file ./apps/admin/test/cypress.config.js",
    "cypress:run": "cypress run --config-file ./apps/admin/test/cypress.config.js",
    "docker:dev": "docker-compose --env-file .env.development up -d --build",
    "docker:prod": "docker-compose --env-file .env.production up -d --build",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@iconify/tailwind": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.10",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "chartjs": "^0.3.24",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cross-env": "^10.1.0",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-jest": "^29.11.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "express-handlebars": "^8.0.2",
    "express-session": "^1.18.2",
    "fs": "^0.0.1-security",
    "hbs": "^4.2.0",
    "js-yaml": "^4.1.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shallow-equal-object": "^1.1.1",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.1.18",
    "typeorm": "^0.3.28",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@iconify/json": "^2.2.419",
    "@iconify/tailwind4": "^1.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/jest-runner": "^9.4.0",
    "@testcontainers/kafka": "^11.11.0",
    "@testcontainers/mongodb": "^11.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/hbs": "^4.0.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "cypress": "^15.8.1",
    "daisyui": "^5.5.14",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.10.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
