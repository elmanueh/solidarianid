@startuml Modelo de Dominio - Users

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor<<aggregate>> #FFEFD5
  BackgroundColor<<entity>> #E6F3FF
  BackgroundColor<<valueobject>> #F0FFF0
  BackgroundColor<<enum>> #FFF0F5
}

' ==================== AGGREGATES ====================
class User <<aggregate>> {
  id: UniqueEntityID
  fullName: FullName
  username: Username
  mobilePhone: MobilePhone
  passwordHash: HashedPassword
  location: UserLocation
}

' ==================== VALUE OBJECTS ====================
class UniqueEntityID <<valueobject>> {
  value: string
}

class FullName <<valueobject>> {
  value: string
}

class Username <<valueobject>> {
  value: string
}

class MobilePhone <<valueobject>> {
  value: string
}

class HashedPassword <<valueobject>> {
  value: string
}

class UserLocation <<valueobject>> {
  city: City
  countryCode: CountryCode
}

class City <<valueobject>> {
  value: string
}

class CountryCode <<valueobject>> {
  value: string
}

' ==================== RELATIONSHIPS ====================
' User relationships
User "1" *-- "1" UniqueEntityID : id
User "1" *-- "1" FullName : fullName
User "1" *-- "1" Username : username
User "1" *-- "1" MobilePhone : mobilePhone
User "1" *-- "1" HashedPassword : passwordHash
User "1" *-- "1" UserLocation : location

' UserLocation relationships
UserLocation "1" *-- "1" City : city
UserLocation "1" *-- "1" CountryCode : countryCode

@enduml
