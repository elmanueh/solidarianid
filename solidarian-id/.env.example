# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/
SESSION_SECRET=your_session_secret_key

# ===========================================
# POSTGRESQL DATABASE
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=solidarian_user
POSTGRES_PASSWORD=solidarian_dev_password
POSTGRES_DB=solidarian_id_db


# ===========================================
# MONGODB DATABASE
# ===========================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=test
MONGO_PASSWORD=test
MONGO_DB=solidarianid
MONGODB_URI=mongodb://test:test@localhost:27017/solidarianid?authSource=admin

# ===========================================
# TESTING (E2E) solo en .env.test
# ===========================================
TEST_SESSION_SECRET=test-secret-key-for-e2e-tests
TEST_MONGO_USER=test
TEST_MONGO_PASSWORD=test
TEST_MONGO_DB=solidarianid-test

# ===========================================
# KAFKA
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_DOCKER_BROKERS=kafka:9093
KAFKA_ADMIN_CLIENT_ID=admin
KAFKA_USERS_CLIENT_ID=users
KAFKA_USERS_CONSUMER_GROUP_ID=users-consumer-group
