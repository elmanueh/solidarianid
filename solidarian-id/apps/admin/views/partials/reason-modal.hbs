<dialog id="reason_modal" class="modal">
  <div class="modal-box space-y-2">
    <h3 class="text-lg font-bold">Introduce un motivo:</h3>
    <textarea
      id="reason-textarea"
      class="textarea w-full"
      placeholder="Introduce un motivo para informar al usuario..."
    ></textarea>
    <p id="reason-error" class="text-sm text-red-500 hidden"></p>
    <div class="flex justify-end">
      <button class="btn btn-success btn-md">
        <span class="icon-[lucide--check]" aria-hidden="true"></span>
        <span>Confirmar</span>
      </button>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
