{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "quoteProps": "preserve",
  "arrowParens": "avoid",
  "printWidth": 120,
  "bracketSpacing": true,
  "plugins": [
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "app/globals.css",
  "tailwindFunctions": [
    "cn",
    "cva"
  ]
}