NODE_ENV=production

# ===========================================
# APPLICATION ADMIN
# ===========================================
ADMIN_PORT=3000
USERS_PORT=3001
COMMUNITIES_PORT=3002
API_BASE_ADMIN_URL=http://localhost:3000/
API_BASE_USERS_URL=http://localhost:3001/
API_BASE_COMMUNITIES_URL=http://localhost:3002/
SESSION_SECRET=your_session_secret_key_change_in_production

# ===========================================
# POSTGRESQL DATABASE
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=solidarian_user
POSTGRES_PASSWORD=solidarian_prod_password_change_this
POSTGRES_DB=solidarian_id_db


# ===========================================
# MONGODB DATABASE
# ===========================================
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=solidarian_mongo_user
MONGO_PASSWORD=solidarian_mongo_password_change_this
MONGO_DB=solidarianid
MONGODB_URI=mongodb://solidarian_mongo_user:solidarian_mongo_password_change_this@mongo:27017/solidarianid?authSource=admin

# ===========================================
# TESTING (E2E) solo en .env.test
# ===========================================
TEST_SESSION_SECRET=test-secret-key-for-e2e-tests
TEST_MONGO_USER=test
TEST_MONGO_PASSWORD=test
TEST_MONGO_DB=solidarianid-test

# ===========================================
# KAFKA
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_DOCKER_BROKERS=kafka:9093
KAFKA_ADMIN_CLIENT_ID=admin
KAFKA_ADMIN_CONSUMER_GROUP_ID=admin-consumer-group
KAFKA_USERS_CLIENT_ID=users
KAFKA_USERS_CONSUMER_GROUP_ID=users-consumer-group
KAFKA_COMMUNITIES_CLIENT_ID=communities
KAFKA_COMMUNITIES_CONSUMER_GROUP_ID=communities-consumer-group
