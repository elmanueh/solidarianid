NODE_ENV=production

# ===========================================
# APPLICATION ADMIN
# ===========================================
ADMIN_PORT=3000
USERS_PORT=3001
COMMUNITIES_PORT=3002
API_BASE_ADMIN_URL=http://localhost:3000/
API_BASE_USERS_URL=http://localhost:3001/
API_BASE_COMMUNITIES_URL=http://localhost:3002/
API_BASE_ADMIN_INTERNAL_URL=http://solidarian_admin_app:3000/
API_BASE_USERS_INTERNAL_URL=http://solidarian_user_app:3001/
API_BASE_COMMUNITIES_INTERNAL_URL=http://solidarian_community_app:3002/
SESSION_SECRET=ado_secret_key

# ===========================================
# POSTGRESQL DATABASE
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ado_user
POSTGRES_PASSWORD=ado_user_password
POSTGRES_DB=solidarian_id_db


# ===========================================
# MONGODB DATABASE
# ===========================================
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=ado_user2
MONGO_PASSWORD=ado_user2_password
MONGO_DB=solidarianid
MONGODB_URI=mongodb://ado_user2:ado_user2_password@mongo:27017/solidarianid?authSource=admin

# ===========================================
# KAFKA
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_DOCKER_BROKERS=kafka:9093
KAFKA_ADMIN_CLIENT_ID=admin
KAFKA_ADMIN_CONSUMER_GROUP_ID=admin-consumer-group
KAFKA_USERS_CLIENT_ID=users
KAFKA_USERS_CONSUMER_GROUP_ID=users-consumer-group
KAFKA_COMMUNITIES_CLIENT_ID=communities
KAFKA_COMMUNITIES_CONSUMER_GROUP_ID=communities-consumer-group