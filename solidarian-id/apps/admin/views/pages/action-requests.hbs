<main class="metrics" aria-labelledby="page-title">
  <h1 id="page-title" class="metrics-title">{{title}}</h1>

  <div class="flex justify-center">
    <span class="bg-base-200 p-2 rounded-xl">Solicitudes pendientes: {{total}}</span>
  </div>

  <div class="space-y-4">{{> tab-action actions=actions }}</div>

  {{> pagination currentPage=currentPage totalPages=totalPages baseUrl="/action-requests"}}
</main>

{{> reason-modal }}
