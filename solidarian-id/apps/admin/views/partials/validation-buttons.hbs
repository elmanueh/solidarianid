<div class="flex gap-1">
  <button class="btn btn-success btn-sm" data-action="approve" aria-label="Aprobar solicitud">
    <span class="icon-[lucide--check]" aria-hidden="true"></span>
    <span class="hidden sm:inline">Validar</span>
  </button>
  <button class="btn btn-error btn-sm" data-action="reject" aria-label="Rechazar solicitud">
    <span class="icon-[lucide--x]" aria-hidden="true"></span>
    <span class="hidden sm:inline">Rechazar</span>
  </button>
</div>
