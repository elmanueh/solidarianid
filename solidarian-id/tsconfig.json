{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "types": ["jest", "node"],
    "paths": {
      "@solidarianid/kafka": ["libs/kafka/src/index.ts"],
      "@solidarianid/testing": ["libs/test/src/index.ts"],
      "@app/admin": ["apps/admin/src"],
      "@app/admin/*": ["apps/admin/src/*"],
      "@app/communities": ["apps/communities/src"],
      "@app/communities/*": ["apps/communities/src/*"],
      "@app/ddd": ["libs/ddd/src"],
      "@app/ddd/*": ["libs/ddd/src/*"],
      "@app/users": ["apps/users/src"],
      "@app/users/*": ["apps/users/src/*"],
      "@app/utils": ["libs/utils/src"],
      "@app/utils/*": ["libs/utils/src/*"],
      "@app/value-objects": ["libs/value-objects/src"],
      "@app/value-objects/*": ["libs/value-objects/src/*"],
      "@frontend/design-tokens": ["libs/design-tokens/src"],
      "@frontend/design-tokens/*": ["libs/design-tokens/src/*"],
      "@charts": ["libs/charts/src"],
      "@charts/*": ["libs/charts/src/*"]
    },
    "baseUrl": "./"
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/cypress.config.ts",
    "**/cypress.config.js",
    "**/cypress/**",
    "**/*.cy.ts",
    "**/*.cy.js"
  ]
}
