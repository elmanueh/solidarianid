@startuml C2-Container-SolidarianID
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

!$ICONURL = "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons"
!include $ICONURL/common.puml
!include $ICONURL/devicons/database.puml
!include $ICONURL/govicons/user_military.puml
!include $ICONURL/govicons/user_suit.puml
!include $ICONURL/font-awesome-5/user_shield.puml
!include $ICONURL/font-awesome-5/users.puml
!include $ICONURL/devicons2/apachekafka_original.puml
!include $ICONURL/devicons2/mongodb.puml
!include $ICONURL/devicons2/postgresql.puml
!include $ICONURL/devicons2/nestjs_original.puml
!include $ICONURL/devicons2/nextjs_line.puml
!include $ICONURL/devicons2/nginx_original.puml

LAYOUT_WITH_LEGEND()
skinparam ArrowThickness 2

title Arquitectura de Contenedores - SolidarianID

' ── Tags ────────────────────────────────────────────────────────────
AddElementTag("monolith",              $bgColor="#6C3483", $fontColor="#FFFFFF")
AddElementTag("monolith-database",     $bgColor="#00943e", $fontColor="#FFFFFF", $borderColor="#FFFFFF", $borderThickness=2)
AddElementTag("microservice",          $bgColor="#db7a03", $fontColor="#FFFFFF")
AddElementTag("microservice-database", $bgColor="#1C2833", $fontColor="#FFFFFF", $borderColor="#FFFFFF", $borderThickness=2)
AddElementTag("message-broker",        $bgColor="#530176", $fontColor="#FFFFFF", $borderColor="#FFFFFF", $borderThickness=2)
AddElementTag("frontend",              $bgColor="#1f6feb", $fontColor="#FFFFFF")
AddElementTag("proxy",                 $bgColor="#5f6a72", $fontColor="#FFFFFF")

' ══════════════════════════════════════════════════════════════════
' CAPA 1 — Actores / Usuarios
' ══════════════════════════════════════════════════════════════════
Person(admin,          "Administrador",       "Personal autorizado de SolidarianID",                        $sprite="user_military")
Person(communityAdmin, "Admin. de comunidad", "Gestiona causas y eventos dentro de su comunidad",           $sprite="user_suit")
Person(userRegistered, "Usuario registrado",  "Ha creado cuenta e iniciado sesión en SolidarianID",         $sprite="user_shield")

' ══════════════════════════════════════════════════════════════════
' CAPA 2 — Frontend Principal
' ══════════════════════════════════════════════════════════════════
Container(mainFrontend, "Frontend principal", "Next.js 14 (App Router)", "SPA/SSR/PWA para usuarios finales. Consume la API REST expuesta por Nginx", $sprite="nextjs_line", $tags="frontend")

' ══════════════════════════════════════════════════════════════════
' CAPA 3 — Proxy Reverso
' ══════════════════════════════════════════════════════════════════
Container(nginxProxy, "Proxy reverso", "Nginx", "Punto de entrada HTTP(S). Enruta tráfico hacia el frontend, la API y el panel de administración", $sprite="nginx_original", $tags="proxy")

' ══════════════════════════════════════════════════════════════════
' CAPA 4 — Aplicaciones y Microservicios
' ══════════════════════════════════════════════════════════════════
System_Boundary(mvpBoundary, "Aplicación Principal (MVP) — Next.js + Microservicios NestJS") {

  System_Boundary(userServiceBoundary, "Microservicio de Usuarios") {
    Container(userService, "User Service", "NestJS", "Registro, autenticación y gestión del perfil de usuario", $sprite="nestjs_original", $tags="microservice")
    ContainerDb(userDatabase, "Users DB", "KurrentDB", "Event store: streams de eventos y proyecciones de usuarios", $sprite="database", $tags="microservice-database")
    ContainerDb(userProjectionDatabase, "User Projections DB", "PostgreSQL", "Proyecciones de consulta optimizadas para usuarios", $sprite="postgresql", $tags="microservice-database")
  }

  System_Boundary(communitiesServiceBoundary, "Microservicio de Comunidades") {
    Container(communitiesService, "Communities Service", "NestJS", "Gestión de comunidades y asociación de miembros", $sprite="nestjs_original", $tags="microservice")
    ContainerDb(communitiesDatabase, "Communities DB", "PostgreSQL", "Datos relacionales de comunidades y membresías", $sprite="postgresql", $tags="microservice-database")
  }
}

System_Boundary(adminBoundary, "Aplicación de Administración — Monolito NestJS MVC") {
  Container(adminMonolith, "Admin Monolith", "NestJS MVC", "Gestiona peticiones HTTP y renderiza vistas Handlebars para el panel de administración", $sprite="nestjs_original", $tags="monolith")
  ContainerDb(adminDatabase, "Admin DB", "MongoDB", "Almacena administradores, usuarios, causas, comunidades, eventos y SDGs", $sprite="mongodb", $tags="monolith-database")
}

' ══════════════════════════════════════════════════════════════════
' CAPA 5 — Bus de Eventos
' ══════════════════════════════════════════════════════════════════
ContainerQueue(kafkaBroker, "Apache Kafka", "Broker de mensajería", "Canal de sincronización asíncrona entre microservicios y monolito", $sprite="apachekafka_original", $tags="message-broker")

' ══════════════════════════════════════════════════════════════════
' LAYOUT — 5 capas verticales
' ══════════════════════════════════════════════════════════════════

' Capa 1: usuarios en horizontal
Lay_R(admin, communityAdmin)
Lay_R(communityAdmin, userRegistered)

' Capa 1 → Capa 2
Lay_D(communityAdmin, mainFrontend)

' Capa 2 → Capa 3
Lay_D(mainFrontend, nginxProxy)

' Capa 3 → Capa 4: nginx ancla hacia ambos sistemas
Lay_D(nginxProxy, userService)
Lay_D(nginxProxy, adminMonolith)

' Capa 4: MVP a la izquierda, Admin a la derecha
Lay_R(userService,        communitiesService)
Lay_R(communitiesService, adminMonolith)

' DBs debajo de sus servicios (permanecen dentro de capa 4)
Lay_D(userService,        userDatabase)
Lay_D(communitiesService, communitiesDatabase)
Lay_D(adminMonolith,      adminDatabase)

' Proyección de usuarios debajo de la User DB, pero alineada a la izquierda para evitar cruces
Lay_R(userDatabase,        userProjectionDatabase)

' Capa 4 → Capa 5
Lay_D(userDatabase,        kafkaBroker)
Lay_D(communitiesDatabase, kafkaBroker)
Lay_D(adminDatabase,       kafkaBroker)

' ══════════════════════════════════════════════════════════════════
' RELACIONES
' ══════════════════════════════════════════════════════════════════

' Usuarios → Frontend (capa 1 → 2)
Rel_D(communityAdmin, mainFrontend, "A1 · Gestiona causas y eventos",        "HTTPS")
Rel_D(userRegistered, mainFrontend, "A2 · Inicia sesión y usa la plataforma", "HTTPS")

' Admin → Nginx directo (capa 1 → 3, saltando frontend)
Rel_D(admin, nginxProxy, "B1 · Accede al panel de administración", "HTTPS")

' Frontend → Nginx (capa 2 → 3)
Rel_D(mainFrontend, nginxProxy, "A3 · Solicitudes de API", "HTTPS / REST")

' Nginx → Microservicios (capa 3 → 4)
Rel_D(nginxProxy, userService,        "A4 · Peticiones de identidad",           "HTTP interno")
Rel_D(nginxProxy, communitiesService, "A5 · Peticiones de comunidades",         "HTTP interno")
Rel_D(nginxProxy, adminMonolith,      "B2 · Redirige tráfico administrativo",   "HTTP interno")

' Microservicios → BBDDs (dentro de capa 4)
Rel_D(userService,        userDatabase,        "A6 · Escribe y lee streams de eventos",   "TCP / gRPC")
Rel_D(userService,        userProjectionDatabase, "A7 · Lee proyecciones de usuarios", "SQL")
Rel_D(communitiesService, communitiesDatabase, "A8 · Lee y escribe datos de comunidades", "SQL")
Rel_D(adminMonolith,      adminDatabase,       "B3 · Lee y escribe datos de administración", "MongoDB Wire Protocol")

' BBDDs / Servicios → Kafka (capa 4 → 5)
Rel_D(adminMonolith,      kafkaBroker, "S1 · Publica y consume eventos", "Kafka Protocol")
Rel_D(userService,        kafkaBroker, "S2 · Publica y consume eventos", "Kafka Protocol")
Rel_D(communitiesService, kafkaBroker, "S3 · Publica y consume eventos", "Kafka Protocol")

SHOW_LEGEND()
@enduml